{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "error",
    "no-redeclare": "error",
    "no-unreachable": "error",
    "no-constant-condition": "error",
    "no-empty": "error",

    "no-console": "off",
    "no-debugger": "error",

    "semi": ["error", "always"],
    "quotes": ["error", "single"]
  }
}